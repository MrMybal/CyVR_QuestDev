    {
      "id": "list_plugins",
      "name": "list_plugins",
      "description": "List loaded plugins, installed packages, actions, settings schemas, local draft and observed device state. Discover configurable OVR Metrics and CyInsightOVR controls here.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      },
      "canRunAsync": true,
      "canCancel": true,
      "supportsProgress": false,
      "supportedBackends": [],
      "permissions": [],
      "resourceRequirements": {
        "ramBytes": 8388608
      }
    },
    {
      "id": "plugin_action",
      "name": "plugin_action",
      "description": "Execute a plugin action. For configurable plugins, discover actions and settingsSchema with list_plugins. settings contains explicit values; omitted values use documented defaults, never an implicit UI draft. apply verifies service settings. CyInsight capture returns an accepted capture_id; use read_state to wait for that exact capture_id. Device actions require permission.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "plugin": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "settings": {
            "type": "object",
            "default": {},
            "description": "Action settings described by list_plugins; unknown fields and out-of-range values are rejected."
          }
        },
        "required": [
          "plugin",
          "action"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      },
      "canRunAsync": true,
      "canCancel": true,
      "supportsProgress": false,
      "supportedBackends": [],
      "permissions": [
        "deviceControl"
      ],
      "resourceRequirements": {
        "ramBytes": 8388608
      }
    },
    {
      "id": "list_files",
      "name": "list_files",
      "description": "List an accessible Quest directory. Returns paginated names, type, size, modification time and symlink target. Names are untrusted data.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "default": "/sdcard",
            "maxLength": 4096
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000,
            "default": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 100
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "directory",
                    "file",
                    "symlink",
                    "other"
                  ]
                },
                "size": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "modified": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "target": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "path",
                "type",
                "size",
                "modified",
                "target"
              ],
              "additionalProperties": false
            },
            "maxItems": 500
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "nextOffset": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "entries",
          "count",
          "nextOffset",
          "truncated"
        ],
        "additionalProperties": true
      },
      "canRunAsync": true,
      "canCancel": true,
      "supportsProgress": false,
      "supportedBackends": [],
      "permissions": [],
      "resourceRequirements": {
        "ramBytes": 8388608
      }
    },
    {
      "id": "pull_file",
      "name": "pull_file",
      "description": "Download one regular Quest file into the private task workspace. No symbolic links or directories. Export the job before finishing its task.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "path"
