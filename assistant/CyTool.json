        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "canRunAsync": true,
      "canCancel": true,
      "supportsProgress": false,
      "supportedBackends": [],
      "permissions": [],
      "resourceRequirements": {
        "ramBytes": 8388608
      }
    },
    {
      "id": "push_file",
      "name": "push_file",
      "description": "Upload one local file to an explicit absolute Quest file path. The source is automatically imported by CyToolsCore; the original is preserved. Replacing a regular destination requires overwrite=true. Subject to action permissions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sourceFile": {
            "type": "string",
            "minLength": 1,
            "description": "Absolute local file path, automatically copied into the private job before use."
          },
          "destination": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "overwrite": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "sourceFile",
          "destination"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      },
      "canRunAsync": true,
      "canCancel": true,
      "supportsProgress": false,
      "supportedBackends": [],
      "permissions": [
        "deviceControl"
      ],
      "resourceRequirements": {
        "ramBytes": 8388608
      }
    },
    {
      "id": "file_action",
      "name": "file_action",
      "description": "Create a directory, rename a Quest entry or delete a regular file/symlink/empty directory. No recursive deletion and no replacement when renaming. Subject to action permissions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "mkdir",
              "rename",
              "delete"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "name": {
            "type": "string",
            "maxLength": 255,
            "default": ""
          }
        },
        "required": [
          "action",
          "path"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      },
      "canRunAsync": true,
      "canCancel": true,
      "supportsProgress": false,
      "supportedBackends": [],
      "permissions": [
        "deviceControl"
      ],
      "resourceRequirements": {
        "ramBytes": 8388608
      }
    },
    {
      "id": "read_metrics",
      "name": "read_metrics",
      "description": "Read the CSV metrics currently open in QuestDev. Dynamic metric IDs come from columns. Times are seconds from the first CSV timestamp; unavailable values are null. Returns bounded samples and recording state.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "metrics": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 16,
            "default": []
          },
          "start": {
            "type": "number",
            "minimum": 0,
            "default": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000,
            "default": 100
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      },
      "canRunAsync": true,
      "canCancel": true,
      "supportsProgress": false,
      "supportedBackends": [],
      "permissions": [],
      "resourceRequirements": {
        "ramBytes": 134217728
      }
    },
    {
      "id": "metrics_action",
      "name": "metrics_action",
      "description": "Open an imported CSV, export the current CSV into this job, refresh/open/follow an OVR report, pause CSV following or stop the active metrics recording. open_csv uses sourceFile imported automatically by Core. Remote path must be a direct CSV in CapturedMetrics. stop_record requires native action approval.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "open_csv",
              "export_csv",
              "refresh_reports",
              "open_report",
              "follow_report",
              "pause",
              "stop_record"
            ]
          },
          "sourceFile": {
            "type": "string",
            "maxLength": 4096
          },
          "path": {
            "type": "string",
            "maxLength": 4096,
            "default": ""
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      },
      "canRunAsync": true,
      "canCancel": true,
      "supportsProgress": false,
      "supportedBackends": [],
      "permissions": [
        "deviceControl"
      ],
      "resourceRequirements": {
        "ramBytes": 134217728
      }
    },
    {
      "id": "record_metrics",
      "name": "record_metrics",
      "description": "Record OVR CSV sessions to the private Core job for 1-300 seconds. The job completes after final collection and CSV mode restoration; cancellation also restores owned CSV mode. An already active CSV mode is preserved. Does not launch/restart a game or change the HUD. filesSaved=0 explicitly means no CSV was produced. Export the job before finishing the task.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300,
            "default": 10
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      },
      "canRunAsync": true,
      "canCancel": true,
      "supportsProgress": false,
      "supportedBackends": [],
      "permissions": [
        "deviceControl"
      ],
      "resourceRequirements": {
        "ramBytes": 134217728
      }
    },
