set(QUESTDEV_CYUI_REVISION "ff023e646c6a3038b3dfbfd53f6d2b4a2f5955e3")
set(CYUI_ROOT "$ENV{CYUI_ROOT}" CACHE PATH "Optional exact CyUI source checkout (see cmake/CyUI.cmake)")
if(NOT CYUI_ROOT)
    include(FetchContent)
    FetchContent_Declare(questdev_cyui
        GIT_REPOSITORY https://github.com/MrMybal/CyUI.git
        GIT_TAG ${QUESTDEV_CYUI_REVISION}
        GIT_SHALLOW FALSE)
    FetchContent_GetProperties(questdev_cyui)
    if(NOT questdev_cyui_POPULATED)
        FetchContent_Populate(questdev_cyui)
    endif()
    set(CYUI_ROOT "${questdev_cyui_SOURCE_DIR}")
endif()
if(EXISTS "${CYUI_ROOT}/.cyui-source-revision")
    file(STRINGS "${CYUI_ROOT}/.cyui-source-revision" actual_revision LIMIT_COUNT 1)
    file(READ "${CYUI_ROOT}/.cyui-source-manifest.json" cyui_manifest)
    string(JSON manifest_revision GET "${cyui_manifest}" revision)
    if(NOT manifest_revision STREQUAL actual_revision)
        message(FATAL_ERROR "CyUI snapshot revision markers disagree")
    endif()
    string(JSON file_count LENGTH "${cyui_manifest}" files)
    file(GLOB_RECURSE snapshot_files LIST_DIRECTORIES FALSE RELATIVE "${CYUI_ROOT}" "${CYUI_ROOT}/*")
    list(REMOVE_ITEM snapshot_files ".cyui-source-revision" ".cyui-source-manifest.json")
    list(LENGTH snapshot_files actual_file_count)
    if(NOT actual_file_count EQUAL file_count)
        message(FATAL_ERROR "CyUI snapshot file list changed")
    endif()
    math(EXPR last_file "${file_count}-1")
    foreach(index RANGE ${last_file})
        string(JSON name MEMBER "${cyui_manifest}" files ${index})
        string(JSON expected_hash GET "${cyui_manifest}" files "${name}")
        if(IS_ABSOLUTE "${name}" OR name MATCHES "(^|/)\\.\\.(/|$)")
            message(FATAL_ERROR "Invalid CyUI snapshot path")
        endif()
        file(SHA256 "${CYUI_ROOT}/${name}" actual_hash)
        if(NOT actual_hash STREQUAL expected_hash)
            message(FATAL_ERROR "CyUI snapshot changed: ${name}")
        endif()
    endforeach()
else()
    find_package(Git REQUIRED)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -c "safe.directory=${CYUI_ROOT}" -C "${CYUI_ROOT}" rev-parse HEAD
        RESULT_VARIABLE revision_result OUTPUT_VARIABLE actual_revision OUTPUT_STRIP_TRAILING_WHITESPACE)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -c "safe.directory=${CYUI_ROOT}" -C "${CYUI_ROOT}" status --porcelain --untracked-files=all
        RESULT_VARIABLE status_result OUTPUT_VARIABLE cyui_changes OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT revision_result EQUAL 0 OR NOT status_result EQUAL 0 OR cyui_changes)
        message(FATAL_ERROR "CyUI must be a clean pinned checkout. Use a separate checkout of ${QUESTDEV_CYUI_REVISION} or omit CYUI_ROOT.")
    endif()
endif()
if(NOT actual_revision STREQUAL QUESTDEV_CYUI_REVISION)
    message(FATAL_ERROR "CyUI revision mismatch: expected ${QUESTDEV_CYUI_REVISION}, found ${actual_revision}")
endif()
set(IMGUI_DIR "${CYUI_ROOT}/third_party/imgui")
# One host-owned ImGui, shared with every selected module and backend.
add_library(quest_imgui STATIC
    "${IMGUI_DIR}/imgui.cpp" "${IMGUI_DIR}/imgui_draw.cpp"
    "${IMGUI_DIR}/imgui_tables.cpp" "${IMGUI_DIR}/imgui_widgets.cpp")
target_include_directories(quest_imgui PUBLIC "${IMGUI_DIR}")
target_compile_features(quest_imgui PUBLIC cxx_std_17)
set(CYUI_IMGUI_TARGET quest_imgui CACHE STRING "" FORCE)
set(CYUI_BUILD_DEMO OFF CACHE BOOL "" FORCE)
set(CYUI_BUILD_AUDIO OFF CACHE BOOL "" FORCE)
set(CYUI_BUILD_GALLERY OFF CACHE BOOL "" FORCE)
set(CYUI_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(CYUI_BUILD_WEB_CEF OFF CACHE BOOL "" FORCE)
set(CYUI_IMGUIZMO_TARGET "" CACHE STRING "" FORCE)
set(CYUI_MODULES "Plots;Images;DocumentViews;CodeEditor" CACHE STRING "" FORCE)
add_subdirectory("${CYUI_ROOT}" "${CMAKE_BINARY_DIR}/cyui")
get_property(QUESTDEV_UI_MODULES GLOBAL PROPERTY CYUI_ENABLED_MODULES)
message(STATUS "QuestDev CyUI ${QUESTDEV_CYUI_REVISION}: Core;${QUESTDEV_UI_MODULES}")
