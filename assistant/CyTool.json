          "action": {
            "type": "string",
            "enum": [
              "launch",
              "stop"
            ]
          },
          "package": {
            "type": "string",
            "minLength": 3,
            "maxLength": 250
          }
        },
        "required": [
          "action",
          "package"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      },
      "canRunAsync": true,
      "canCancel": true,
      "supportsProgress": false,
      "supportedBackends": [],
      "permissions": [
        "deviceControl"
      ],
      "resourceRequirements": {
        "ramBytes": 8388608
      }
