    {
      "id": "adb_execute",
      "name": "adb_execute",
      "description": "Run an explicit ADB or Android shell command on the selected device. Subject to QuestDev action permissions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "mode": {
            "type": "string",
            "enum": [
              "shell",
              "adb"
            ],
            "default": "shell"
          },
          "timeout": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300,
            "default": 30
          }
        },
        "required": [
          "command"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      },
      "canRunAsync": true,
      "canCancel": true,
      "supportsProgress": false,
      "supportedBackends": [],
      "permissions": [
        "deviceControl"
      ],
      "resourceRequirements": {
        "ramBytes": 8388608
      }
    },
    {
      "id": "device_action",
      "name": "device_action",
      "description": "Run a device action. Parameters have the same effect as the native Device Actions controls. record_video waits for completion (max 180s); video_stop finalizes an active recording. Perfetto max 120s. mirror_start waits for a real video texture and native window; mirror_stop waits for shutdown/finalization. mirror settings control video quality and audio. Recording the mirror is available from the native UI.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "wake",
              "sleep",
              "reboot",
              "gpu_on",
              "gpu_off",
              "proximity_on",
              "proximity_off",
              "boundary_on",
              "boundary_off",
              "hud_on",
              "hud_off",
              "metrics_on",
              "metrics_off",
              "metrics_export",
              "wifi_on",
              "usb",
              "screenshot",
              "record_video",
              "video_stop",
              "mirror_start",
              "mirror_stop",
              "browser",
              "perfetto"
            ]
          },
          "url": {
            "type": "string",
            "default": ""
          },
          "seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 180,
            "default": 10
          },
          "mirror": {
            "type": "object",
            "properties": {
              "maxSize": {
                "type": "integer",
                "minimum": 256,
                "maximum": 4096,
                "default": 1920
              },
              "maxFps": {
                "type": "integer",
                "minimum": 15,
                "maximum": 120,
                "default": 60
              },
              "bitRateMbps": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100,
                "default": 12
              },
              "audio": {
                "type": "string",
                "enum": [
                  "off",
                  "duplicate",
                  "output"
                ],
                "default": "duplicate"
              },
              "fullscreen": {
                "type": "boolean",
                "default": false
              }
            },
            "additionalProperties": false,
            "default": {}
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "canRunAsync": true,
      "canCancel": true,
      "supportsProgress": false,
      "supportedBackends": [],
      "permissions": [
        "deviceControl"
      ],
      "resourceRequirements": {
        "ramBytes": 8388608
      }
    },
    {
      "id": "application_action",
      "name": "application_action",
      "description": "Launch or stop an installed package on the selected Quest.",
      "inputSchema": {
        "type": "object",
